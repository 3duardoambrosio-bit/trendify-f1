  "auditor_required_output": {
    "verdict_values": [
      "PASS",
      "PASS_WITH_NOTES",
      "FAIL"
    ],
    "decision_values": {
      "EXPERT_QUALITY_DECISION": [
        "EXPERT_CONFIRMED",
        "EXPERT_PARTIAL",
        "EXPERT_NOT_CONFIRMED"
      ],
      "INDEPENDENCE_DECISION": [
        "INDEPENDENT_ENOUGH",
        "PARTIALLY_INDEPENDENT",
        "NOT_INDEPENDENT"
      ],
      "SAFETY_DECISION": [
        "SAFE_LOCAL_AUDIT_ONLY_NO_LIVE_NO_SPEND",
