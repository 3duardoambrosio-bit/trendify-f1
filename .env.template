# ============================================================
# SYNAPSE .env.template — S19
# Copy to .env and fill in real values before production.
# ============================================================

# Telegram Alerts (S17/S19)
# Create a bot via @BotFather, get the token.
# Get chat_id by messaging your bot, then: curl https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Reconciliation Pre-flight (S18/S19)
# Paths to Shopify orders JSON and ledger NDJSON for reconciliation gate.
# If both set, ops_tick runs reconcile before any spending.
# If either is empty, reconcile gate is skipped.
SYNAPSE_RECONCILE_ORDERS=
SYNAPSE_RECONCILE_LEDGER=

# Vault State File (S13)
# Default: data/vault/vault_state.json
# Override for testing or multi-environment setups.
SYNAPSE_VAULT_STATE_FILE=data/vault/vault_state.json

# Feature Flags
# meta_live_api: OFF = mock mode (no real Meta API calls). ON = real.
# Default: OFF (safe).
# Set in feature flags file or env var:
meta_live_api=false
